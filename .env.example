# Образец конфигурации локального запуска MVP-среза (см. compose.yaml).
# Скопируйте в .env и заполните:  cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- База данных -------------------------------------------------------------
# Пароль PostgreSQL для обеих зон (зелёная и красная). Значение подставляется в
# DSN, поэтому используйте URL-безопасные символы (без @ : / ? # и пробелов).
POSTGRES_PASSWORD=lead-gen-dev

# --- Firecrawl (обязательно) -------------------------------------------------
# Ключ доступа Firecrawl — поиск и обход. Без него сервис не собирается.
FIRECRAWL_API_KEY=fc-...

# Базовый адрес Firecrawl API (необязательно; пусто — адрес по умолчанию).
# FIRECRAWL_BASE_URL=

# Проверенный режим демо-заявки на 25 лидов (параметры процесса demand).
# FIRECRAWL_MAX_CREDITS=150
# FIRECRAWL_CRAWL_INTERVAL=5s
# LEAD_MAX_PAGES=2
# LEAD_MAX_TIME_SECONDS=15
# LEAD_SEARCH_MAX_RESULTS=50
# LEAD_SEARCH_DEADLINE=8m

# --- LLM / DeepSeek (обязательно для демо писем) -----------------------------
# Без LLM_API_KEY генерация писем и планирование через OpenAI-совместимый API
# недоступны; поиск может работать на слоях экстракции 1–2.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# --- Консоль -----------------------------------------------------------------
# Порт консоли наружу (по умолчанию 8080).
# LEAD_HTTP_PORT=8080

# --- Консоль -----------------------------------------------------------------
# Логин и пароль входа в консоль (по умолчанию operator / secret). Раскомментируйте
# и замените на свои, если хотите другие креды.
# CONSOLE_USER=operator
# CONSOLE_PASSWORD=secret
