<p class="live-region" id="console-live" role="status" aria-live="polite" aria-atomic="true" aria-label="Объявления" data-live-region></p>
<header class="page-head">
  <h1>Задание</h1>
</header>

<article class="card job-detail">
  <header class="card-head">
    <h2>Запрос</h2>
    <p class="job-query">агентства автоматизации B2B</p>
    <p class="card-source">
      <span class="status status-done" title="найдено компаний 2">Готово</span>
      <span class="job-id">job-1</span>
    </p>
  </header>

  <section class="card-section">
    <h3>Сводка</h3>
    <dl class="job-facts">
      <dt>Создано</dt><dd> 02.01.2026 10:00</dd>
      <dt>Обновлено</dt><dd> 02.01.2026 10:00</dd>
      <dt>Найдено компаний</dt><dd> 2</dd>
      <dt>Бюджет</dt><dd> —</dd>
      <dt>Ход</dt><dd> завершение · страниц 12 · компаний 2 · токенов 340</dd>
    </dl>
  </section>

  <section class="card-section">
    <h3>Сводка отбора</h3>
    <dl class="job-facts">
      <dt>Цель по лидам</dt><dd>—</dd>
      <dt>Найдено</dt><dd>2</dd>
    </dl>

    <h4>Охват поиска</h4>
    <dl class="job-facts">
      <dt>Обойдено страниц</dt><dd>12</dd>
      <dt>Найдено компаний</dt><dd>2</dd>
      <dt>Ошибок разбора</dt><dd>0</dd>
      <dt>Ошибок оценки</dt><dd>0</dd><dt>Токены</dt><dd>340</dd>
    </dl>

    <h4>Воронка отбора</h4>
    <ol class="selection-funnel">
      <li class="funnel-point is-known">
        <span class="funnel-label">Найдено</span>
        <span class="funnel-count">2</span>
      </li>
      <li class="funnel-point is-known">
        <span class="funnel-label">Email проверен</span>
        <span class="funnel-count">0</span>
      </li>
      <li class="funnel-point is-known">
        <span class="funnel-label">Оценено</span>
        <span class="funnel-count">2</span>
      </li>
      <li class="funnel-point is-known">
        <span class="funnel-label">Подходит</span>
        <span class="funnel-count">1</span>
      </li>
      <li class="funnel-point is-known">
        <span class="funnel-label">Гипотеза</span>
        <span class="funnel-count">1</span>
      </li>
      <li class="funnel-point is-known">
        <span class="funnel-label">Не подходит</span>
        <span class="funnel-count">0</span>
      </li>
      <li class="funnel-point is-unavailable">
        <span class="funnel-label">Писем</span>
        <span class="funnel-count">недоступно</span>
      </li>
      <li class="funnel-point is-unavailable">
        <span class="funnel-label">Отправлено</span>
        <span class="funnel-count">недоступно</span>
      </li>
      <li class="funnel-point is-unavailable">
        <span class="funnel-label">Ответили</span>
        <span class="funnel-count">недоступно</span>
      </li>
    </ol>
  </section>

  <section class="card-section">
    <h3>Распределение оценок</h3>
    <dl class="verdict-distribution">
      <dt>Подходит</dt><dd data-verdict="fits">1</dd>
      <dt>Гипотеза</dt><dd data-verdict="hypothesis">1</dd>
      <dt>Не подходит</dt><dd data-verdict="unsuitable">0</dd>
    </dl>
    <p class="hint"><a class="link" href="/cards?job=job-1">Открыть список результатов по оценкам</a></p>
  </section>

  <section class="card-section">
    <h3>Причины отсева</h3>
    <ul class="rejection-categories">
      <li class="rejection-category">
        <p class="rejection-head">
          <a class="link" href="/cards?job=job-1&amp;reason=missing&amp;actor=operator">Гипотеза</a>
          <span class="count">1</span>
          <a class="link" href="/cards?job=job-1&amp;reason=missing&amp;actor=operator">К списку</a>
        </p>
        <ul class="rejection-groups">
          <li><a class="link" href="/cards?detail=%D0%BF%D1%80%D1%8F%D0%BC%D0%BE%D0%B5&#43;%D0%B7%D0%B0%D1%8F%D0%B2%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5&#43;%D0%BE&#43;%D0%BF%D0%BE%D1%82%D1%80%D0%B5%D0%B1%D0%BD%D0%BE%D1%81%D1%82%D0%B8&amp;job=job-1&amp;reason=missing&amp;actor=operator">прямое заявление о потребности</a> <span class="count">1</span></li>
        </ul>
      </li>
      <li class="rejection-category">
        <p class="rejection-head">
          <a class="link" href="/cards?job=job-1&amp;reason=no-email&amp;actor=operator">нет email / email недоступен</a>
          <span class="count">2</span>
          <a class="link" href="/cards?job=job-1&amp;reason=no-email&amp;actor=operator">К списку</a>
        </p>
      </li>
    </ul>
  </section>

  <section class="card-section">
    <h3>Подходящие: основания и источники</h3>
    <ul class="fit-list">
      <li class="fit-item">
        <p class="fit-head">
          <a class="link" href="/cards/example.com?job=job-1">example.com</a>
          <span class="verdict verdict-fits">Подходит</span>
          <span class="assessment-signal">косвенный сигнал</span>
        </p>
        <ul class="evidence-list">
  <li class="evidence-item">
    <dl class="evidence-facts">
      <dt>Критерий</dt><dd>агентства автоматизации B2B-продаж</dd><dt>Факт</dt><dd>компания наняла руководителя отдела продаж</dd><dt>Объяснение связи</dt><dd>рост отдела продаж указывает на потребность в автоматизации</dd>
      <dt>Тип сигнала</dt><dd>косвенный сигнал</dd><dt>Источник</dt><dd><a class="link" href="https://example.com/careers" rel="noopener noreferrer">https://example.com/careers</a></dd>
    </dl>
  </li>
</ul>
      </li>
    </ul>
  </section>

  <section class="card-section">
    <h3>Найденные компании</h3>
    <ul class="socials">
      <li class="job-company is-no-email" aria-label="example.com — нет email">
        <a class="link" href="/cards/example.com?job=job-1">example.com</a>
        <span class="card-email"><span class="card-no-email">нет email</span></span> <span class="verdict verdict-fits">Подходит</span>
      </li>
      <li class="job-company is-no-email" aria-label="alpha.example — нет email">
        <a class="link" href="/cards/alpha.example?job=job-1">alpha.example</a>
        <span class="card-email"><span class="card-no-email">нет email</span></span> <span class="verdict verdict-hypothesis">Гипотеза</span>
      </li>
    </ul>
  </section>

  <section class="card-section">
    <h3>Ход выполнения</h3>
    <ol class="timeline">
  <li class="timeline-point is-done" data-detail="02.01.2026 10:00" title="02.01.2026 10:00">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Поставлено в очередь</span><span class="timeline-detail" role="tooltip">02.01.2026 10:00</span>
  </li>
  <li class="timeline-point is-done" data-detail="02.01.2026 10:00 · обход · страниц 10 · компаний 2" title="02.01.2026 10:00 · обход · страниц 10 · компаний 2">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Фаза: обход</span><span class="timeline-detail" role="tooltip">02.01.2026 10:00 · обход · страниц 10 · компаний 2</span>
  </li>
  <li class="timeline-point is-done" data-detail="02.01.2026 10:00 · завершение · страниц 12 · компаний 2 · токенов 340" title="02.01.2026 10:00 · завершение · страниц 12 · компаний 2 · токенов 340">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Завершено</span><span class="timeline-detail" role="tooltip">02.01.2026 10:00 · завершение · страниц 12 · компаний 2 · токенов 340</span>
  </li>
</ol>
  </section>

  <footer class="card-actions">
    <a class="link" href="/">← К журналу</a>
    <form method="post" action="/jobs/job-1/reassess">
      <input type="hidden" name="csrf" value="TOKEN">
      <button class="button-secondary" type="submit">Переоценить компании</button>
    </form>
  </footer>
</article>
