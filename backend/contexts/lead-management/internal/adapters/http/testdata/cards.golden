<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Карточки</title>
  <link rel="stylesheet" href="/static/console.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/console.js" defer></script>
  <script src="/static/assistant.js" defer></script>
</head>
<body>
  <nav class="sidebar">
  <ul class="sidebar-list">
    <li><a href="/">Главная</a></li>
    <li><a href="/cards" class="is-active" aria-current="page">Карточки</a></li>
    <li><a href="/leads">Лиды</a></li>
    <li><a href="/funnel">Воронка</a></li>
    <li><a href="/send">Отправка</a></li>
    <li><a href="/assistant">Ассистент</a></li>
    <li><a href="/forum-signals">Форумы</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Тема оформления">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page">
<header class="page-head">
  <h1>Карточки</h1>
</header>

<section class="panel">
  
  <div class="cards-toolbar">
    <div class="composition-switch" role="group" aria-label="Состав результатов">
      <button type="button" class="view-option is-active" data-composition-set="fits" aria-pressed="true">Подходящие</button>
      <button type="button" class="view-option" data-composition-set="other" aria-pressed="false">Неподходящие и гипотезы</button>
    </div>
    <div class="view-switch" role="group" aria-label="Вид списка карточек">
      <button type="button" class="view-option is-active" data-view-set="tiles" aria-pressed="true">Плитки</button>
      <button type="button" class="view-option" data-view-set="rows" aria-pressed="false">Строки</button>
    </div>
  </div>

  
  <div class="cards" data-cards-view="tiles" data-cards-composition="fits">
    
    
  <a class="cards-item" href="/cards/example.com" data-group="other">
    <span class="card-email">hello@example.com</span>
    <span class="card-name">Пример Компании</span><span class="card-verdict verdict verdict-unknown">Не оценено</span>
    <span class="card-desc">Описание компании с email</span>
  </a>
  <a class="cards-item is-no-email" href="/cards/phone.example.com" data-group="other" aria-label="Только Телефон — нет email">
    <span class="card-email"><span class="card-no-email">нет email</span></span>
    <span class="card-name">Только Телефон</span><span class="card-verdict verdict verdict-unknown">Не оценено</span>
    <span class="card-desc">Описание компании без email</span>
  </a>
    <p class="empty cards-empty" data-group="fits">Подходящих компаний пока нет</p>
  </div>
</section>
  </main>
</body>
</html>