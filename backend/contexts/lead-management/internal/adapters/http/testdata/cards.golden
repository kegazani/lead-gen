<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Карточки</title>
  <link rel="stylesheet" href="/static/console.css">
  <link rel="stylesheet" href="/static/cards.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/console.js" defer></script>
  <script src="/static/assistant.js" defer></script>
  <script src="/static/console-a11y.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <nav class="sidebar" aria-label="Основная навигация">
  <ul class="sidebar-list">
    <li><a href="/validation?actor=operator">Заявки</a></li>
    <li><a href="/approvals?actor=operator">Исполнение</a></li>
    <li><a href="/?actor=operator" class="is-active" aria-current="page">Лиды</a></li>
    <li><a href="/dashboard?actor=operator">Отчёты</a></li>
    <li><a href="/outreach/drafts?actor=operator">Рассылки</a></li>
    <li><a href="/console/tenant?actor=operator">Тенант</a></li>
    <li><a href="/console/users?actor=operator">Пользователи</a></li>
    <li><a href="/console/registrations?actor=operator">Регистрации</a></li>
    <li><a href="/console/integrations?actor=operator">Интеграции</a></li>
    <li><a href="/console/audit?actor=operator">Аудит</a></li>
    <li><a href="/platform/topology?actor=operator">Топология</a></li>
    <li><a href="/platform/operations?actor=operator">Операции</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button"
    aria-label="Тема оформления"
    data-theme-label-system="Как в системе"
    data-theme-label-light="Светлая"
    data-theme-label-dark="Тёмная"
    data-theme-aria="Тема оформления: %s. Нажмите, чтобы сменить.">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page" id="main-content">
<nav class="tabs">
  <a class="tab" href="/?actor=operator">Главная</a>
  <a class="tab is-active" href="/cards?actor=operator" aria-current="page">Карточки</a>
  <a class="tab" href="/leads?actor=operator">Лиды</a>
  <a class="tab" href="/funnel?actor=operator">Воронка</a>
</nav>
<p class="live-region" id="console-live" role="status" aria-live="polite" aria-atomic="true" aria-label="Объявления" data-live-region></p>
<header class="page-head">
  <h1>Карточки</h1>
</header>

<p class="hint" role="status" aria-live="polite" data-lead-refresh-status></p>
<section class="panel" data-lead-results data-tenant-id="" data-refresh-error="Не удалось обновить список. Показаны последние полученные данные." data-refresh-updated="Список сохранённых компаний обновлён.">
  <p class="hint">Показано сохранённых компаний: <strong data-saved-company-count>2</strong></p>
  <div class="cards-toolbar">
    <div class="view-switch" role="group" aria-label="Вид списка карточек">
      <button type="button" class="view-option is-active" data-view-set="tiles" aria-pressed="true">Плитки</button>
      <button type="button" class="view-option" data-view-set="rows" aria-pressed="false">Строки</button>
    </div>
  </div>

  <div class="cards" data-cards-view="tiles" data-global-catalog="true" data-cards-composition="all">
  <a class="cards-item" href="/cards/example.com" >
    <span class="card-email">hello@example.com</span>
    <span class="card-name">Пример Компании</span><span class="card-phone">&#43;7 999 123-45-67</span>
    <span class="card-contact-state hint">Контакты найдены</span><span class="card-contact-source hint">Источник: https://example.com</span>
    <span class="card-desc">Описание компании с email</span>
  </a>
  <a class="cards-item is-no-email" href="/cards/phone.example.com"  aria-label="Только Телефон — нет email">
    <span class="card-email"><span class="card-no-email">нет email</span></span>
    <span class="card-name">Только Телефон</span>
    <span class="card-contact-state hint">Нет пригодных контактов</span>
    <span class="card-desc">Описание компании без email</span>
  </a>
  </div>
</section>
  </main>
</body>
</html>