<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Пример Компании</title>
  <link rel="stylesheet" href="/static/console.css">
  <link rel="stylesheet" href="/static/cards.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/console.js" defer></script>
  <script src="/static/assistant.js" defer></script>
  <script src="/static/console-a11y.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <nav class="sidebar" aria-label="Основная навигация">
  <ul class="sidebar-list">
    <li><a href="/validation?actor=operator">Заявки</a></li>
    <li><a href="/approvals?actor=operator">Исполнение</a></li>
    <li><a href="/?actor=operator" class="is-active" aria-current="page">Лиды</a></li>
    <li><a href="/dashboard?actor=operator">Отчёты</a></li>
    <li><a href="/outreach/drafts?actor=operator">Рассылки</a></li>
    <li><a href="/console/tenant?actor=operator">Тенант</a></li>
    <li><a href="/console/users?actor=operator">Пользователи</a></li>
    <li><a href="/console/registrations?actor=operator">Регистрации</a></li>
    <li><a href="/console/integrations?actor=operator">Интеграции</a></li>
    <li><a href="/console/audit?actor=operator">Аудит</a></li>
    <li><a href="/platform/topology?actor=operator">Топология</a></li>
    <li><a href="/platform/operations?actor=operator">Операции</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button"
    aria-label="Тема оформления"
    data-theme-label-system="Как в системе"
    data-theme-label-light="Светлая"
    data-theme-label-dark="Тёмная"
    data-theme-aria="Тема оформления: %s. Нажмите, чтобы сменить.">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page" id="main-content">
<nav class="tabs">
  <a class="tab" href="/?actor=operator">Главная</a>
  <a class="tab is-active" href="/cards?actor=operator" aria-current="page">Карточки</a>
  <a class="tab" href="/leads?actor=operator">Лиды</a>
  <a class="tab" href="/funnel?actor=operator">Воронка</a>
</nav>
<p class="live-region" id="console-live" role="status" aria-live="polite" aria-atomic="true" aria-label="Объявления" data-live-region></p>
<header class="page-head">
  <h1>Карточка</h1>
</header>

<article class="card">
  <header class="card-head">
    <h2>Пример Компании</h2>
    <p class="card-source">
      <span class="status status-not-warmed">Не прогрет</span>
      <span class="provenance"><a href="https://example.com" rel="noopener noreferrer">https://example.com</a> <time datetime="02.01.2026">02.01.2026</time></span>
    </p>
  </header>
  <p class="card-description">Описание компании</p>

  <section class="card-section">
    <h3>Стадия</h3>
    <ol class="timeline">
  <li class="timeline-point is-current">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Не прогрет</span>
  </li>
  <li class="timeline-point is-pending">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Письмо отправлено</span>
  </li>
  <li class="timeline-point is-pending">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Прогрев</span>
  </li>
  <li class="timeline-point is-pending">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="timeline-label">Холодный</span>
  </li>
</ol>
  </section>
  <section class="card-section assessment">
    <h3>Почему эта оценка?</h3>
    <p class="assessment-verdict">
      <span class="verdict verdict-unsuitable">Не подходит</span>
      <span class="assessment-signal">Тип сигнала: совпадение по профилю</span> <span class="assessment-context job-id">job-unsuitable</span>
    </p>
    <ul class="evidence-list">
  <li class="evidence-item">
    <dl class="evidence-facts">
      <dt>Критерий</dt><dd>только компании с собственным отделом продаж</dd><dt>Факт</dt><dd>внешние продажи через партнёров</dd><dt>Объяснение связи</dt><dd>обязательное ограничение запроса не выполнено</dd>
      <dt>Тип сигнала</dt><dd>совпадение по профилю</dd><dt>Несоответствие</dt><dd>нет собственного отдела продаж — обязательное ограничение запроса</dd><dt>Источник</dt><dd><a class="link" href="https://example.com/services" rel="noopener noreferrer">https://example.com/services</a></dd>
    </dl>
  </li>
</ul>
  </section>
  <section class="card-section">
    <h3>Соцсети</h3>
    <ul class="socials">
      <li><a class="link" href="https://www.linkedin.com/company/example" rel="noopener noreferrer">https://www.linkedin.com/company/example</a></li>
    </ul>
  </section>

  <section class="card-section">
    <h3>Контакты</h3>
    <p class="hint">Проверены формат и источник контактов. Доставка email и доступность телефона не подтверждены.</p>
    <table class="table">
      <thead>
        <tr><th>Email</th><th>Телефон</th><th>Роль</th><th>Источник</th><th>Верификация</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>hello@example.com</td>
          <td>&#43;7 999 123-45-67</td>
          <td>основатель</td>
          <td>
            <span class="provenance"><a href="https://example.com" rel="noopener noreferrer">https://example.com</a> <time datetime="02.01.2026">02.01.2026</time></span><span class="method">regex</span>
          </td>
          <td><span class="verify verify-unknown" title="неизвестно"><span class="verify-icon" aria-hidden="true">?</span><span class="verify-label">неизвестно</span></span>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="card-section">
    <h3>Переписка</h3>
    <p class="empty">Переписки пока нет</p>
  </section>

  <details class="disclosure">
    <summary>Отложить</summary>
    <div class="reveal"><div class="disclosure-body">
      <form method="post" action="/cards/example.com/snooze">
        <input type="hidden" name="csrf" value="TOKEN">
        <p class="field">
          <label for="days">Дней</label>
          <input id="days" name="days" type="text" value="7">
        </p>
        <p class="actions"><button class="button-secondary" type="submit">Отложить</button></p>
      </form>
    </div></div>
  </details>

  <details class="disclosure">
    <summary>Отправить письмо</summary>
    <div class="reveal"><div class="disclosure-body">
      <form method="post" action="/cards/example.com/send">
        <input type="hidden" name="key" value="TOKEN">
        <input type="hidden" name="csrf" value="TOKEN">
        <p class="field">
          <label for="template">Шаблон</label>
          <select id="template" name="template">
            <option value="">— выберите шаблон —</option>
            <option value="intro">Приветствие</option>
          </select>
        </p>
        
        <p class="actions">
          <button type="button" class="button-secondary" hx-post="/cards/example.com/send/preview" hx-include="closest form" hx-target="#email-preview">Предпросмотр</button>
          <button type="submit">Отправить</button>
        </p>
      </form>
      <div id="email-preview" data-live-announce="Карточка обновлена" data-focus-after-swap="#email-preview"></div>
    </div></div>
  </details>

  <section class="card-section">
    <h3>Библиотека шаблонов</h3>
    <form class="search-form" method="get" action="/cards/example.com?job=job-unsuitable" hx-get="/cards/example.com?job=job-unsuitable" hx-target="#template-list" hx-swap="innerHTML">
  <p class="field">
    <label for="template-query">Поиск шаблона</label>
    <input id="template-query" name="q" type="text" value="">
  </p>
  <p class="actions"><button type="submit">Найти</button></p>
</form>
<div id="template-list" data-live-announce="Список шаблонов обновлён" data-focus-after-swap="#template-list">

<ul class="template-list">
  <li class="template-item">
    <a class="link" href="/cards/example.com?template=intro&amp;job=job-unsuitable">Приветствие</a>
    <span class="template-meta">Тема для {{company}} · Редакция: 1</span>
  </li>
</ul>
</div>
  </section>

  <footer class="card-actions">
    <form method="post" action="/cards/example.com/hide">
      <input type="hidden" name="csrf" value="TOKEN">
      <button class="button-secondary" type="submit">Скрыть</button>
    </form>
    <form method="post" action="/cards/example.com/delete">
      <input type="hidden" name="csrf" value="TOKEN">
      <button class="button-danger" type="submit">Удалить</button>
    </form>
  </footer>
</article>
  </main>
</body>
</html>