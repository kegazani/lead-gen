<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Операции: цифры процесса</title>
  <link rel="stylesheet" href="/static/console.css">
  <script src="/static/console-a11y.js" defer></script>
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <nav class="sidebar" aria-label="Основная навигация">
  <ul class="sidebar-list">
    <li><a href="/validation?actor=user-1&amp;tenant_id=tenant-1">Заявки</a></li>
    <li><a href="/approvals?actor=user-1&amp;tenant_id=tenant-1">Исполнение</a></li>
    <li><a href="/?actor=user-1&amp;tenant_id=tenant-1" class="is-active" aria-current="page">Лиды</a></li>
    <li><a href="/dashboard?actor=user-1&amp;tenant_id=tenant-1">Отчёты</a></li>
    <li><a href="/outreach/drafts?actor=user-1&amp;tenant_id=tenant-1">Рассылки</a></li>
    <li><a href="/console/tenant?actor=user-1&amp;tenant_id=tenant-1">Тенант</a></li>
    <li><a href="/console/users?actor=user-1&amp;tenant_id=tenant-1">Пользователи</a></li>
    <li><a href="/console/registrations?actor=user-1&amp;tenant_id=tenant-1">Регистрации</a></li>
    <li><a href="/console/integrations?actor=user-1&amp;tenant_id=tenant-1">Интеграции</a></li>
    <li><a href="/console/audit?actor=user-1&amp;tenant_id=tenant-1">Аудит</a></li>
    <li><a href="/platform/topology?actor=user-1&amp;tenant_id=tenant-1">Топология</a></li>
    <li><a href="/platform/operations?actor=user-1&amp;tenant_id=tenant-1" class="is-active" aria-current="page">Операции</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button"
    aria-label="Тема оформления"
    data-theme-label-system="Как в системе"
    data-theme-label-light="Светлая"
    data-theme-label-dark="Тёмная"
    data-theme-aria="Тема оформления: %s. Нажмите, чтобы сменить.">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page" id="main-content">
<section class="cockpit" data-cockpit>
  <h1>Операции: цифры процесса</h1>
  <table class="table">
    <thead>
      <tr>
        <th>Категория</th>
        <th>Найдено</th>
        <th>Обработано</th>
        <th>Отклонено</th>
        <th>В работе</th>
        <th>Результат</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Всего</td>
        <td><a class="status status-queued" href="/platform/operations/agents?actor=user-1&amp;category=found&amp;tenant_id=tenant-1"><span aria-hidden="true">◈</span> 7</a></td>
        <td><a class="status status-done" href="/platform/operations/agents?actor=user-1&amp;category=processed&amp;tenant_id=tenant-1"><span aria-hidden="true">■</span> 4</a></td>
        <td><a class="status status-failed" href="/platform/operations/agents?actor=user-1&amp;category=rejected&amp;tenant_id=tenant-1"><span aria-hidden="true">✕</span> 2</a></td>
        <td><a class="status status-running" href="/platform/operations/agents?actor=user-1&amp;category=in_progress&amp;tenant_id=tenant-1"><span aria-hidden="true">▸</span> 1</a></td>
        <td><a class="status status-active" href="/platform/operations/agents?actor=user-1&amp;category=result&amp;tenant_id=tenant-1"><span aria-hidden="true">✓</span> 0</a></td>
      </tr>
      <tr>
        <td>tenant-1</td>
        <td><a class="status status-queued" href="/platform/operations/agents?actor=user-1&amp;category=found&amp;client_id=tenant-1&amp;tenant_id=tenant-1"><span aria-hidden="true">◈</span> 7</a></td>
        <td><a class="status status-done" href="/platform/operations/agents?actor=user-1&amp;category=processed&amp;client_id=tenant-1&amp;tenant_id=tenant-1"><span aria-hidden="true">■</span> 4</a></td>
        <td><a class="status status-failed" href="/platform/operations/agents?actor=user-1&amp;category=rejected&amp;client_id=tenant-1&amp;tenant_id=tenant-1"><span aria-hidden="true">✕</span> 2</a></td>
        <td><a class="status status-running" href="/platform/operations/agents?actor=user-1&amp;category=in_progress&amp;client_id=tenant-1&amp;tenant_id=tenant-1"><span aria-hidden="true">▸</span> 1</a></td>
        <td><a class="status status-active" href="/platform/operations/agents?actor=user-1&amp;category=result&amp;client_id=tenant-1&amp;tenant_id=tenant-1"><span aria-hidden="true">✓</span> 0</a></td>
      </tr>
    </tbody>
  </table>
  <h2>Разбивка по времени</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Дата</th>
        <th>Найдено</th>
        <th>Обработано</th>
        <th>Отклонено</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>2026-10-06</td>
        <td>7</td>
        <td>4</td>
        <td>2</td>
      </tr>
    </tbody>
  </table>

  <h2>Заявки и исполнение</h2>
  <p class="notice" role="status">Список заявок недоступен</p>

  <h2>Панели</h2>
  <div class="cockpit-panels">
    <section class="cockpit-panel" data-panel-id="operations_workflow_started">
      <h3>Старт процессов</h3>
      <p class="hint">Источник: метрики · Обновление: опрос</p>
      <p class="notice" role="status">недоступно</p>
      <form method="post" action="/platform/operations/panels/toggle?actor=user-1&amp;tenant_id=tenant-1" class="inline-form">
        <input type="hidden" name="csrf" value="csrf-token">
        <input type="hidden" name="panel" value="operations_workflow_started">
        <input type="hidden" name="hidden" value="true">
        <button type="submit">Скрыть</button>
      </form>
    </section>
    <section class="cockpit-panel" data-panel-id="operations_workflow_errors">
      <h3>Ошибки старта процессов</h3>
      <p class="hint">Источник: метрики · Обновление: опрос</p>
      <p class="notice" role="status">недоступно</p>
      <form method="post" action="/platform/operations/panels/toggle?actor=user-1&amp;tenant_id=tenant-1" class="inline-form">
        <input type="hidden" name="csrf" value="csrf-token">
        <input type="hidden" name="panel" value="operations_workflow_errors">
        <input type="hidden" name="hidden" value="true">
        <button type="submit">Скрыть</button>
      </form>
    </section>
    <section class="cockpit-panel" data-panel-id="operations_http_error_ratio">
      <h3>Доля серверных ошибок</h3>
      <p class="hint">Источник: метрики · Обновление: опрос</p>
      <p class="notice" role="status">недоступно</p>
      <form method="post" action="/platform/operations/panels/toggle?actor=user-1&amp;tenant_id=tenant-1" class="inline-form">
        <input type="hidden" name="csrf" value="csrf-token">
        <input type="hidden" name="panel" value="operations_http_error_ratio">
        <input type="hidden" name="hidden" value="true">
        <button type="submit">Скрыть</button>
      </form>
    </section>
    <section class="cockpit-panel" data-panel-id="process_overview">
      <h3>Сводка процессов</h3>
      <p class="hint">Источник: процессы · Обновление: опрос</p>
      <p class="notice" role="status">недоступно</p>
      <form method="post" action="/platform/operations/panels/toggle?actor=user-1&amp;tenant_id=tenant-1" class="inline-form">
        <input type="hidden" name="csrf" value="csrf-token">
        <input type="hidden" name="panel" value="process_overview">
        <input type="hidden" name="hidden" value="true">
        <button type="submit">Скрыть</button>
      </form>
    </section>
  </div>
</section>
  </main>
</body>
</html>