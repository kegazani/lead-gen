<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Валидация заявки req-1</title>
  <link rel="stylesheet" href="/static/console.css">
  <script src="/static/console-a11y.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <nav class="sidebar" aria-label="Основная навигация">
  <ul class="sidebar-list">
    <li><a href="/validation?actor=operator&amp;tenant_id=tenant-1" class="is-active" aria-current="page">Заявки</a></li>
    <li><a href="/approvals?actor=operator&amp;tenant_id=tenant-1">Исполнение</a></li>
    <li><a href="/?actor=operator&amp;tenant_id=tenant-1">Лиды</a></li>
    <li><a href="/dashboard?actor=operator&amp;tenant_id=tenant-1">Отчёты</a></li>
    <li><a href="/outreach/drafts?actor=operator&amp;tenant_id=tenant-1">Рассылки</a></li>
    <li><a href="/console/tenant?actor=operator&amp;tenant_id=tenant-1">Тенант</a></li>
    <li><a href="/console/users?actor=operator&amp;tenant_id=tenant-1">Пользователи</a></li>
    <li><a href="/console/registrations?actor=operator&amp;tenant_id=tenant-1">Регистрации</a></li>
    <li><a href="/console/integrations?actor=operator&amp;tenant_id=tenant-1">Интеграции</a></li>
    <li><a href="/console/audit?actor=operator&amp;tenant_id=tenant-1">Аудит</a></li>
    <li><a href="/platform/topology?actor=operator&amp;tenant_id=tenant-1">Топология</a></li>
    <li><a href="/platform/operations?actor=operator&amp;tenant_id=tenant-1">Операции</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button"
    aria-label="Тема оформления"
    data-theme-label-system="Как в системе"
    data-theme-label-light="Светлая"
    data-theme-label-dark="Тёмная"
    data-theme-aria="Тема оформления: %s. Нажмите, чтобы сменить.">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page" id="main-content">
<section class="validation-screen" hx-boost="true">
  <p class="live-region" id="console-live" role="status" aria-live="polite" aria-atomic="true" aria-label="Объявления" data-live-region></p>
  <h1>Валидация заявки</h1>
  <p class="hint">
    <span class="status status-validating">Создана</span>
    <span class="request-id">№ req-1</span>
  </p>

  <div class="split">
    <div>
      <section id="offer" hx-target="this" hx-swap="innerHTML" data-focus-after-swap="#offer" data-live-announce="Состояние заявки обновлено">
        <article class="offer">
  <h2>Оффер</h2>
  <p class="offer-content">Предлагаем автоматизацию найма</p>
  <dl class="facts">
    <div><dt>Цель:</dt><dd class="offer-target">IT-компании</dd></div>
    <div><dt>Версия оффера:</dt><dd class="offer-revision">1</dd></div>
  </dl>
</article>
      </section>
      <form class="fact-panel" method="post" action="/requests/req-1/validation/offer">
        <h2>Правка оффера</h2>
        <input type="hidden" name="tenant_id" value="tenant-1">
        <input type="hidden" name="csrf" value="TOKEN">
        <p class="field">
  <label for="offer-content">Оффер</label>
  <textarea id="offer-content" name="content" rows="6" required>Предлагаем автоматизацию найма</textarea>
</p>
        <p class="field">
  <label for="offer-target">Цель заявки</label>
  <input id="offer-target" name="target" type="text" value="IT-компании">
</p>
        <button type="submit" class="button-secondary">Сохранить правку</button>
      </form>
    </div>

    <div>
      <div class="fact-panel">
        <h2>Решение по заявке</h2>
        <form method="post" action="/requests/req-1/validation/approve">
          <input type="hidden" name="tenant_id" value="tenant-1">
          <input type="hidden" name="csrf" value="TOKEN">
          <p class="field">
            <label for="lead-target">Цель по числу лидов</label>
            <input id="lead-target" name="lead_target" type="number" min="0" step="1" value="">
            <span class="field-hint">Необязательно; пусто или 0 — без цели</span>
          </p>
          <button type="submit">Одобрить и начать поиск</button>
        </form>

        <form class="card-section" method="post" action="/requests/req-1/validation/call">
          <input type="hidden" name="tenant_id" value="tenant-1">
          <input type="hidden" name="csrf" value="TOKEN">
          <input type="hidden" name="correlation_id" value="req-1">
          <p class="hint">Если оффер неясен, уточните его у клиента звонком.</p>
          <button type="submit" class="button-secondary">Инициировать звонок-уточнение</button>
        </form>

        <form class="card-section" method="post" action="/requests/req-1/validation/reject">
          <input type="hidden" name="tenant_id" value="tenant-1">
          <input type="hidden" name="csrf" value="TOKEN">
          <p class="field">
  <label for="reject-reason">Причина отклонения</label>
  <input id="reject-reason" name="reason" type="text" value="" required>
</p>
          <button type="submit" class="button-danger">Отклонить</button>
        </form>
      </div>
    </div>
  </div>
</section>
  </main>
</body>
</html>