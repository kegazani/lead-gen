<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/static/theme.js"></script>
  <title>Заявки компании</title>
  <link rel="stylesheet" href="/static/console.css">
  <script src="/static/console-a11y.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <nav class="sidebar" aria-label="Основная навигация">
  <ul class="sidebar-list">
    <li><a href="/validation?actor=operator&amp;tenant_id=tenant-1" class="is-active" aria-current="page">Заявки</a></li>
    <li><a href="/approvals?actor=operator&amp;tenant_id=tenant-1">Исполнение</a></li>
    <li><a href="/?actor=operator&amp;tenant_id=tenant-1">Лиды</a></li>
    <li><a href="/dashboard?actor=operator&amp;tenant_id=tenant-1">Отчёты</a></li>
    <li><a href="/outreach/drafts?actor=operator&amp;tenant_id=tenant-1">Рассылки</a></li>
    <li><a href="/console/tenant?actor=operator&amp;tenant_id=tenant-1">Тенант</a></li>
    <li><a href="/console/users?actor=operator&amp;tenant_id=tenant-1">Пользователи</a></li>
    <li><a href="/console/registrations?actor=operator&amp;tenant_id=tenant-1">Регистрации</a></li>
    <li><a href="/console/integrations?actor=operator&amp;tenant_id=tenant-1">Интеграции</a></li>
    <li><a href="/console/audit?actor=operator&amp;tenant_id=tenant-1">Аудит</a></li>
    <li><a href="/platform/topology?actor=operator&amp;tenant_id=tenant-1">Топология</a></li>
    <li><a href="/platform/operations?actor=operator&amp;tenant_id=tenant-1">Операции</a></li>
  </ul>
  <button class="theme-toggle" id="theme-toggle" type="button"
    aria-label="Тема оформления"
    data-theme-label-system="Как в системе"
    data-theme-label-light="Светлая"
    data-theme-label-dark="Тёмная"
    data-theme-aria="Тема оформления: %s. Нажмите, чтобы сменить.">
    <span class="theme-toggle-label">Тема</span>
    <b class="theme-toggle-value" data-theme-name>Как в системе</b>
  </button>
</nav>
  <main class="page" id="main-content">
<section class="company-requests" data-tenant="tenant-1" data-status-labels="{&#34;cancelled&#34;:&#34;Отменена&#34;,&#34;failed&#34;:&#34;Сбой&#34;,&#34;fulfilled&#34;:&#34;Выполнена&#34;,&#34;needs-revision&#34;:&#34;Нужна доработка&#34;,&#34;processing&#34;:&#34;В работе&#34;,&#34;rejected&#34;:&#34;Отклонена&#34;,&#34;submitted&#34;:&#34;Создана&#34;,&#34;validated&#34;:&#34;Создана&#34;,&#34;validating&#34;:&#34;Создана&#34;}">
  <p class="live-region" id="console-live" role="status" aria-live="polite" aria-atomic="true" aria-label="Объявления" data-live-region></p>
  <h1>Заявки компании</h1>
  <p class="hint">Все заявки выбранной компании с историей переходов. <span class="tenant-label">Клиент: tenant-1</span></p>
  <article class="request-card fact-panel">
    <header>
      <h2>Заявка для истории</h2>
      <p class="hint">
        <span class="status status-processing" data-request-id="req-1">В работе</span>
        <span class="request-id">№ req-1</span>
      </p>
    </header>
    <form class="card-section" method="post" action="/requests/req-1/revision">
      <input type="hidden" name="tenant_id" value="tenant-1">
      <input type="hidden" name="csrf" value="TOKEN">
      <p class="hint">Объясните клиенту, что нужно исправить.</p>
      <textarea name="reason" required></textarea>
      <button type="submit" class="button-secondary">Вернуть на доработку</button>
    </form>
    <form class="card-section" method="post" action="/requests/req-1/cancel">
      <input type="hidden" name="tenant_id" value="tenant-1">
      <input type="hidden" name="csrf" value="TOKEN">
      <p class="hint">Отмена необратима; укажите причину.</p>
      <textarea name="reason" required></textarea>
      <button type="submit" class="button-danger">Отменить</button>
    </form>

    <details class="history">
      <summary>История переходов</summary>
      <ol class="transitions">
        <li class="transition">
          <span class="transition-path">Переход: submitted</span>
          <span class="transition-actor">Актор: client</span>
          <span class="transition-at">Время: 2026-01-02T03:04:05Z</span>
        </li>
        <li class="transition">
          <span class="transition-path">Переход: submitted → validating</span>
          <span class="transition-actor">Актор: actor-1</span>
          <span class="transition-at">Время: 2026-01-02T03:04:05Z</span>
        </li>
        <li class="transition">
          <span class="transition-path">Переход: validating → validated</span>
          <span class="transition-actor">Актор: actor-1</span>
          <span class="transition-at">Время: 2026-01-02T03:04:05Z</span>
        </li>
        <li class="transition">
          <span class="transition-path">Переход: validated → processing</span>
          <span class="transition-actor">Актор: actor-1</span>
          <span class="transition-at">Время: 2026-01-02T03:04:05Z</span>
        </li>
      </ol>
    </details>
  </article>
  <script src="/static/company_requests.js" defer></script>
</section>
  </main>
</body>
</html>