{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lead-gen.local/architecture/domain-catalog.schema.json",
  "title": "Каталог доменной архитектуры lead-gen",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contexts", "entities", "aggregates", "value_objects", "domain_events", "policies", "relationships", "required_diagrams"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/context"}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/aggregate"}
    },
    "value_objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/valueObject"}
    },
    "domain_events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domainEvent"}
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policy"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "required_diagrams": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/diagram"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "classification", "purpose", "capabilities", "deployed_by", "contracts"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "classification": {"enum": ["core", "supporting", "generic"]},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "deployed_by": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["api", "ingest", "sender", "worker", "chains", "schedule"]},
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner_context", "zone", "storage"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "owner_context": {"$ref": "#/$defs/identifier"},
        "zone": {"enum": ["green", "red", "analytics", "mixed"]},
        "storage": {"enum": ["relational", "client-relational", "object", "analytics", "workflow", "external"]}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_context", "root_entity", "entities", "value_objects", "domain_events", "policies", "invariants"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner_context": {"$ref": "#/$defs/identifier"},
        "root_entity": {"$ref": "#/$defs/identifier"},
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "value_objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "domain_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "policies": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "valueObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_context", "owner_aggregate", "semantics"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner_context": {"$ref": "#/$defs/identifier"},
        "owner_aggregate": {"$ref": "#/$defs/identifier"},
        "semantics": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "domainEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_context", "producing_aggregate"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner_context": {"$ref": "#/$defs/identifier"},
        "producing_aggregate": {"$ref": "#/$defs/identifier"}
      }
    },
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["domain-event", "contract"]},
        "id": {"$ref": "#/$defs/identifier"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_context", "owner_aggregate", "inputs", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner_context": {"$ref": "#/$defs/identifier"},
        "owner_aggregate": {"$ref": "#/$defs/identifier"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/policyReference"},
          "uniqueItems": true
        },
        "action": {"$ref": "#/$defs/policyReference"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "upstream", "downstream", "pattern", "integration", "contract"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "upstream": {"$ref": "#/$defs/identifier"},
        "downstream": {"$ref": "#/$defs/identifier"},
        "pattern": {"enum": ["customer-supplier", "conformist", "published-language", "anticorruption-layer"]},
        "integration": {"enum": ["command", "event", "query", "policy"]},
        "contract": {"$ref": "#/$defs/identifier"}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "contexts"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^architecture/diagrams/[a-z0-9-]+\\.puml$"},
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      }
    }
  }
}
