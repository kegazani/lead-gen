@startuml bounded-context-map
title Карта bounded contexts: границы сервисов
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

package "Generic" {
  rectangle "Управление платформой\nи доступом\n<<generic>>" as Platform
  rectangle "Управление данными\n<<generic>>" as Governance
  rectangle "Интеграционная платформа\n<<generic, ACL>>" as Integration
}
package "Core" {
  rectangle "Управление лидами\n<<core>>" as Leads
  rectangle "Аудитория\n<<core>>" as Audience
  rectangle "Оркестрация исходящих\nдействий\n<<core>>" as Outreach
  rectangle "Доставка сообщений\n<<core>>" as Delivery
  rectangle "Продажи и сделки\n<<core>>" as Sales
}
package "Supporting" {
  rectangle "Производство контента\n<<supporting>>" as Content
  rectangle "Наблюдение\nвзаимодействия\n<<supporting>>" as Engagement
  rectangle "Аналитика сообществ\n<<supporting>>" as Community
  rectangle "Публикация материалов\n<<supporting>>" as Publishing
  rectangle "Аналитика и отчётность\n<<supporting>>" as Analytics
  rectangle "Биллинг\n<<supporting>>" as Billing
}

Governance --> Leads : data-zone-policy
Governance --> Outreach : processing-authority
Governance --> Delivery : suppression-policy
Platform --> Outreach : access-decision
Leads --> Audience : lead-profile
Audience --> Outreach : audience-snapshot
Content --> Outreach : content-version
Outreach --> Delivery : approved-action
Delivery --> Engagement : delivery-event
Engagement --> Outreach : engagement-event
Outreach --> Sales : outreach-outcome
Sales --> Billing : attributed-result
Community --> Publishing : community-digest
Outreach --> Analytics
Delivery --> Analytics
Engagement --> Analytics
Sales --> Analytics
Integration ..> Leads : ACL / provider-port
Integration ..> Content : ACL / provider-port
Integration ..> Delivery : ACL / provider-port
Integration ..> Sales : ACL / provider-port
Integration ..> Community : ACL / provider-port
Integration ..> Publishing : ACL / provider-port

legend bottom
  Границы сервисов совпадают с границами bounded contexts:
  один контекст — один сервис (14 сервисов).
  Роли api / ingest / sender / worker / chains / schedule —
  режимы запуска внутри сервиса, а не единицы размещения.
  Консоль топологии — эксплуатационная проекция роли api
  сервиса platform-governance, а не отдельный контекст или сервис:
  граф строится из объявлений каталога, метрики читаются
  из Prometheus через серверный прокси.
endlegend

' CTX:platform-governance
' CTX:data-governance
' CTX:lead-management
' CTX:audience
' CTX:content-production
' CTX:outreach-orchestration
' CTX:message-delivery
' CTX:engagement-observation
' CTX:sales-workflow
' CTX:community-intelligence
' CTX:publishing
' CTX:analytics
' CTX:billing
' CTX:integration-platform
@enduml
