@startuml bounded-context-map
title Карта bounded contexts: границы сервисов
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

package "Generic" {
  rectangle "Управление платформой\nи доступом\n<<generic>>" as Platform
  rectangle "Управление данными\n<<generic>>" as Governance
  rectangle "Интеграционная платформа\n<<generic, ACL>>" as Integration
  note right of Integration
    capability: provider-token-budget
    primary owner: integration-platform
    lead-management consumes published LLM
    budget contract; no foreign domain import
    Первый research путь:
    research-acquisition-attempt / receipt
    firecrawl-credit-account / grant
    Денежный ledger только Firecrawl
    Browser/OCR и собственный crawler — план
  end note
}
package "Core" {
  rectangle "Управление лидами\n<<core>>" as Leads
  note right of Leads
    capability: lead-workflow, lead-email
    Первый research путь:
    research-dossier / source / attempt-memory
    Sources, assertions, OpenNeed в red
    Полный граф и inbound conversations — план
  end note
  rectangle "Аудитория\n<<core>>" as Audience
  note right of Audience
    План intelligent-lead-research:
    international-market-discovery
  end note
  rectangle "Оркестрация исходящих\nдействий\n<<core>>" as Outreach
  note right of Outreach
    План intelligent-lead-research:
    research-to-outreach
  end note
  rectangle "Доставка сообщений\n<<core>>" as Delivery
  rectangle "Исполнение заявок\nклиента\n<<core>>" as Requests
  rectangle "Оркестрация агентов\nкомпаний\n<<core>>" as Agents
  note right of Agents
    Первый research путь:
    research-mission / action / member
    SearchBrief / StrategyCell / QueryFamily, grant_ref
    PostgreSQL intent / lease / receipt
    Новый research outbox не публикуется
  end note
}
package "Supporting" {
  rectangle "Производство контента\n<<supporting>>" as Content
  rectangle "Наблюдение\nвзаимодействия\n<<supporting>>" as Engagement
  rectangle "Аналитика и отчётность\n<<supporting>>" as Analytics
}

Governance --> Leads : data-zone-policy
Governance --> Outreach : processing-authority
Governance --> Delivery : suppression-policy
Platform --> Outreach : access-decision
Platform --> Requests : tenant-context
Platform --> Agents : access-decision
Leads --> Audience : lead-profile
Leads --> Requests : lead-profile
Leads --> Agents : lead-search / email-generation
Outreach --> Agents : campaign-command
Delivery --> Agents : delivery-event
Engagement --> Agents : engagement-event
Agents --> Analytics : agent-event
Analytics --> Platform : campaign-report
Audience --> Outreach : audience-snapshot
Audience --> Requests : audience-snapshot
Content --> Outreach : content-version
Outreach --> Delivery : approved-action
Delivery --> Engagement : delivery-event
Engagement --> Outreach : engagement-event
Outreach --> Requests : campaign-state
Delivery --> Requests : delivery-event
Outreach --> Analytics
Delivery --> Analytics
Engagement --> Analytics
Integration ..> Leads : ACL / provider-port
Integration ..> Content : ACL / provider-port
Integration ..> Delivery : ACL / provider-port
Integration --> Platform : adapter-status
Agents --> Requests : research-mission / research-plan
Leads --> Agents : research-memory
Leads --> Requests : research-memory (dossier)
Integration ..> Agents : research-acquisition / provider-port

Integration ..> Leads : research-extraction\nsync · in-process
Leads --> Requests : research-memory / IdentityPort\nsync · in-process

legend bottom
  Границы сервисов совпадают с границами bounded contexts:
  один контекст — один сервис (12 сервисов).
  Роли api / ingest / sender / worker / chains / schedule —
  режимы запуска внутри сервиса, а не единицы размещения.
  Пометки «План» сохраняют объём последующих capability.
  Первый research путь — написанные модели и published ports;
  полная приёмка фиксируется отдельно в OpenSpec tasks.
  Новые связи research при co-location: sync · in-process.
  Консоль топологии — эксплуатационная проекция роли api
  сервиса platform-governance, а не отдельный контекст или сервис:
  граф строится из объявлений каталога, метрики читаются
  из Prometheus через серверный прокси.
endlegend

' CTX:platform-governance
' CTX:data-governance
' CTX:lead-management
' CTX:audience
' CTX:content-production
' CTX:outreach-orchestration
' CTX:message-delivery
' CTX:engagement-observation
' CTX:analytics
' CTX:integration-platform
' CTX:request-fulfillment
' CTX:agent-orchestration
@enduml
