@startuml data-ownership
title Владение доменными данными и зоны хранения
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

rectangle "platform-governance\n---\ntenant [green]\nuser-role [green]\naudit-record [green]" as Platform
rectangle "data-governance\n---\nprocessing-basis [red]\nsuppression-entry [red]" as Governance
rectangle "lead-management\n---\ncompany [mixed]\ncontact [red]\nattribute-provenance [red]\nemail-verification [red]\ncompany-size-profile [green]" as Leads
rectangle "audience\n---\nlead-score [red]\nsegment [red]\naudience-snapshot [red]" as Audience
rectangle "content-production\n---\ncontent-asset [green]\ncontent-version [green]\nlanding-content [green]\ndocument [green]\nrender-job [green]" as Content
rectangle "outreach-orchestration\n---\ncampaign [green]\nsequence-definition [green]\nsequence-execution [green]\naction-draft [green]\noperator-decision [green]\ncall [red]" as Outreach
rectangle "message-delivery\n---\nmessage [green]\nsender-reputation [green]" as Delivery
rectangle "engagement-observation\n---\nengagement-event [analytics]" as Engagement
rectangle "sales-workflow\n---\ndeal [red, external SoR]\ncrm-sync [green]" as Sales
rectangle "community-intelligence\n---\ncommunity-digest [green]" as Community
rectangle "publishing\n---\npublication [green]" as Publishing
rectangle "analytics\n---\nreport-snapshot [analytics]" as Analytics
rectangle "billing\n---\nsubscription-invoice [green]\nsuccess-fee [green]" as Billing

Platform -[hidden]-> Governance
Governance -[hidden]-> Leads
Leads -[hidden]-> Audience
Audience -[hidden]-> Content
Content -[hidden]-> Outreach
Outreach -[hidden]-> Delivery
Delivery -[hidden]-> Engagement
Engagement -[hidden]-> Sales
Sales -[hidden]-> Community
Community -[hidden]-> Publishing
Publishing -[hidden]-> Analytics
Analytics -[hidden]-> Billing

note bottom
  Owner изменяет authoritative state.
  Другие contexts хранят только ID, contract snapshot или собственную projection.
  red = client-controlled storage; mixed = zoning per attribute;
  analytics = обезличенная/агрегированная read model; external = внешний system of record.
end note

' CTX:platform-governance
' CTX:data-governance
' CTX:lead-management
' CTX:audience
' CTX:content-production
' CTX:outreach-orchestration
' CTX:message-delivery
' CTX:engagement-observation
' CTX:sales-workflow
' CTX:community-intelligence
' CTX:publishing
' CTX:analytics
' CTX:billing
@enduml
